{
  "name": "discord-zero-bot",
  "private": true,
  "workspaces": [
    "database",
    "storage",
    "bot"
  ],
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && tsc -p database && tsc -p storage && tsc -p bot",
    "check:fix": "oxlint --fix && oxfmt --write",
    "dev": "docker compose up -d database storage && cd bot && bun run start",
    "start": "bun run bot/src/index.ts"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
