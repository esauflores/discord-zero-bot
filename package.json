{
  "name": "discord-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && tsc --noEmit",
    "check:fix": "oxlint --fix && oxfmt --write",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:push": "drizzle-kit push",
    "deploy-commands": "bun run src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
